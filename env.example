# ErrorInsight Configuration
# Copy this file to .env and customize as needed.

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=errorinsight-super-secret-key-change-in-production

# Authentication API Key for external clients (e.g. friend's Log Parser)
# Header expected: X-API-Key: your_api_key_here
API_KEY=dev-secret-key-12345

# Database path (defaults to error_insight.db in application root)
DATABASE_PATH=error_insight.db

# Max request payload size in bytes (16MB default)
MAX_CONTENT_LENGTH=16777216

# LogScope integration for the "Analyse further" action
LOGSCOPE_API_URL=https://log-scope-three.vercel.app
# Optional shared secret; set the same LOGSCOPE_API_KEY on LogScope if enabled
LOGSCOPE_API_KEY=
